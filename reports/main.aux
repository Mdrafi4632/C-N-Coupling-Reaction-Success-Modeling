\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Random vs scaffold-OOD comparison}{10}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Random vs scaffold-OOD test accuracy} for the top classifiers. Unlike the v1 regressors (which collapsed below R$^2 = 0$ on scaffold-OOD), the binary classifier retains meaningful accuracy on unseen scaffolds: $0.59$ for the best model vs.\ a majority-class baseline of $0.53$, and AUC $\approx 0.64$ indicating real (if weak) ranking ability.\relax }}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:clf-split-compare}{{5}{10}{\textbf {Random vs scaffold-OOD test accuracy} for the top classifiers. Unlike the v1 regressors (which collapsed below R$^2 = 0$ on scaffold-OOD), the binary classifier retains meaningful accuracy on unseen scaffolds: $0.59$ for the best model vs.\ a majority-class baseline of $0.53$, and AUC $\approx 0.64$ indicating real (if weak) ranking ability.\relax }{figure.caption.16}{}}
