\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-model classification metrics on the random 70/15/15 test set after binarising at yield $\geq 50\%$. Accuracy and MCC are shown side-by-side; models are sorted by accuracy. The best individual classifiers are \texttt  {LightGBM} (acc 0.921, MCC $+0.82$, AUC 0.97) and Chemprop (acc 0.918, MCC $+0.82$, AUC 0.97). The dotted line marks the no-information baseline (always predict the majority class), accuracy 68.1\%.\relax }}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:clf-per-model-random}{{2}{6}{Per-model classification metrics on the random 70/15/15 test set after binarising at yield $\geq 50\%$. Accuracy and MCC are shown side-by-side; models are sorted by accuracy. The best individual classifiers are \texttt {LightGBM} (acc 0.921, MCC $+0.82$, AUC 0.97) and Chemprop (acc 0.918, MCC $+0.82$, AUC 0.97). The dotted line marks the no-information baseline (always predict the majority class), accuracy 68.1\%.\relax }{figure.caption.9}{}}
